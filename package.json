{
  "name": "hosfera",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "hosfera — PMS + channel manager para aluguel por temporada",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "test": "node --test tests/",
    "typecheck": "tsc --noEmit",
    "seed": "node src/cli/seed.ts",
    "smoke": "node src/cli/smoke.ts",
    "doctor": "node scripts/doctor.ts",
    "check": "npm run doctor && npm run typecheck && npm test && npm run smoke",
    "reset": "node -e \"require('node:fs').rmSync('./data',{recursive:true,force:true});console.log('banco local apagado')\""
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
