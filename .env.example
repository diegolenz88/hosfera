# hosfera — configuração local
PORT=3000
HOST=127.0.0.1

# Banço: caminho do arquivo SQLite. Use `:memory:` nos testes.
DATABASE_PATH=./data/hosfera.db

# Bootstrap: cria a primeira organização e o primeiro token (owner).
# Remova/rotacione depois do setup; em produção, sem esta variável o endpoint é 404.
HOSFERA_BOOTSTRAP=dev-bootstrap
# valor de produção: openssl rand -hex 32

# Dispatcher do outbox
DISPATCH_INTERVAL_MS=2000
DISPATCH_BATCH=25
MAX_ATTEMPTS=6

# Adaptadores habilitados (mock sempre disponível em desenvolvimento)
ENABLE_MOCK_CHANNEL=true

# Booking.com — protocolo pronto; preencha e homologe antes de BOOKING_CERTIFIED=true
BOOKING_ACCOUNT=
BOOKING_AUTH_VALUE=
BOOKING_HOTEL_CODE=
BOOKING_WEBHOOK_SECRET=
BOOKING_CERTIFIED=false
